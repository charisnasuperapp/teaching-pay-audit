rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAccountOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    match /users/{userId}/salaryAudit/database {
      allow get: if isAccountOwner(userId);
      allow list: if false;
      allow create, update: if isAccountOwner(userId)
        && request.resource.data.keys().hasOnly(['settings', 'monthKeys', 'updatedAt'])
        && request.resource.data.settings is map
        && request.resource.data.monthKeys is list
        && request.resource.data.monthKeys.size() <= 600
        && request.resource.data.updatedAt is string;
      allow delete: if isAccountOwner(userId);
    }

    match /users/{userId}/salaryAuditMonths/{monthKey} {
      allow get: if isAccountOwner(userId)
        && monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
      allow list: if false;
      allow create, update: if isAccountOwner(userId)
        && monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['monthKey', 'hourlyRate', 'entries', 'isPristine', 'updatedAt'])
        && request.resource.data.monthKey == monthKey
        && request.resource.data.hourlyRate is number
        && request.resource.data.hourlyRate >= 0
        && request.resource.data.entries is map
        && request.resource.data.isPristine is bool
        && request.resource.data.updatedAt is string;
      allow delete: if isAccountOwner(userId);
    }
  }
}
