rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    match /users/{userId}/profile/account {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /users/{userId}/salaryAudit/database {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['settings', 'monthKeys', 'updatedAt'])
        && request.resource.data.settings is map
        && request.resource.data.monthKeys is list
        && request.resource.data.monthKeys.size() <= 600
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/salaryAuditMonths/{monthKey} {
      allow get: if isOwner(userId)
        && monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
      allow list: if false;
      allow create, update: if isOwner(userId)
        && monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['monthKey', 'hourlyRate', 'entries', 'isPristine', 'updatedAt'])
        && request.resource.data.monthKey == monthKey
        && request.resource.data.hourlyRate is number
        && request.resource.data.hourlyRate >= 0
        && request.resource.data.entries is map
        && request.resource.data.isPristine is bool
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
